# Copy to .env and set paths for your machine. .env is gitignored.
#
# Control-machine only (your Mac). Edge stack vars (MQTT, Node-RED, etc.) are in
# docker/env.example and are deployed to /opt/docker/.env on each Pi.

# Required for bin/ansible-* and infra-* scripts.
# Path to ha-infra-config (real inventory and docker/ configs).
HA_INFRA_CONFIG=/Users/you/Developer/projects/ha-infra-config
# Required for bin/infra-backup-edge-stack.
# User-defined mirror root on this Mac. Keep backups outside git.
HA_INFRA_BACKUP=/Users/you/Developer/projects/ha-infra-backup

# Optional: FTP client tests (bin/infra-ftp-test). Never commit real passwords.
# HA_INFRA_FTP_HOST=edge-node-1.example.lan
# HA_INFRA_FTP_USER=ftpuser
# HA_INFRA_FTP_PASSWORD=
# HA_INFRA_FTP_PORT=21
# Explicit FTPS (AUTH TLS). Use TLS_INSECURE=1 for self-signed certs from the ftp role.
# HA_INFRA_FTP_TLS=1
# HA_INFRA_FTP_TLS_INSECURE=1

# Optional: shared guest SMB credentials (MikroTik + Samba public share).
# Used for manual mounts / future helpers. Never commit real passwords.
# HA_GUEST_USER=guest
# HA_GUEST_PASS=
